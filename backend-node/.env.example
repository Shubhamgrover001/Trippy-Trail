# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Path of the SQLite file (created automatically)
DATABASE_PATH=./data/trippy-trail.db
# Folder with the website files (the trippy-trail-launch folder). Served at /
SITE_DIR=./public
# Set to 1 when running behind a proxy/host that sets X-Forwarded-For (Netlify functions, Render, Hostinger, nginx)
TRUST_PROXY=0
# Used only by: npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Razorpay (added in the next step). Leave empty until you have TEST keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
